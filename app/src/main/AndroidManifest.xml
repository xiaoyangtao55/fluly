<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="false" />
    <!-- Weather requests coarse location only after the user taps the system-location
         setting. Manual city search remains the no-permission fallback. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 精确位置一起声明，但仍然是「用户点了才申请」。
         两个理由：①Android 12+ 的系统弹窗只有在同一次请求里同时收到粗/精两个权限时，
         才会给出「精确 / 大致」二选一；只声明粗的，用户连选精确的机会都没有。
         ②GPS 与 passive provider 缺了 FINE 会抛 SecurityException，被 runCatching 吞掉
         之后表现为定位一直等到超时（见 filterWatchWeatherLocationProvidersByPermission），
         于是 {alat} / {alon} / {aalt} 永远拿不到数据源。
         只授予粗定位时我们会主动把那两个 provider 筛掉，功能不依赖用户必须给精确位置。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Watch faces can show upcoming events through the {cex} / {cNxx} tags. The
         permission is requested only when the user taps that row in settings; until
         then those tags render as unavailable and nothing is queried. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 表盘下滑拉出系统控制中心。这是 normal 级权限（不是签名权限），安装即授予。
         类名 StatusBarManager 带 @hide 不代表权限受限 —— 见 service/SystemStatusBar.kt。 -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- 锁屏表盘的悬浮窗路径（lockscreen/LockScreenFaceOverlay）：拥有本权限时，
         从任意 App 熄屏也能用 TYPE_APPLICATION_OVERLAY 把表盘盖在 Keyguard 上，
         绕开「其他应用前台时 startActivity 撞后台启动限制」的问题。2.4.0 曾作为
         「未使用权限」清理过，现在有了真实用途。special 级权限：设置里的锁屏表盘
         开关开启时引导用户去系统设置授予（Settings.canDrawOverlays 判定），不授予则
         维持原有的 HOME 前台门禁 + Activity 路径，行为不变。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 悬浮窗保活：持窗进程只有「缓存」优先级，LMK 随时收割、窗口跟着陪葬
         （装机实测 pid 一秒一换）。FGS 把进程抬到前台服务优先级；
         从后台启动 FGS 依赖的正是上面已授予的 SYSTEM_ALERT_WINDOW 豁免。
         见 lockscreen/LockScreenFaceOverlayService。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 锁屏表盘主路径：安全锁屏期间系统会强制隐藏第三方悬浮窗（防锁屏覆盖攻击，
         装机实测 mForceHideNonSystemOverlayWindow=true），悬浮窗压不到 Keyguard 上。
         改用全屏意图通知（full-screen intent）从后台拉起 setShowWhenLocked 的锁屏
         Activity——来电全屏界面同款机制，Android 12 上是安装即授的 normal 权限。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 接收旧式「添加到主屏幕」广播。同是 normal 级权限，安装即授予，用户无感。
         这一条不声明，receiver 写得再对也收不到：绝大多数仍在用旧路径的应用是这样投递的 ——
             sendBroadcast(intent, "com.android.launcher.permission.INSTALL_SHORTCUT")
         带权限的重载只投递给**持有该权限**的接收方，不声明就直接跳过。
         Android 8.0 起系统自身不再发这条广播，但应用自己发的不受影响，
         所以它和 ShortcutReceiverActivity 的 PIN 请求路径是互补关系，不是替代关系。 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- 编辑器 / 商店在 Flue Studio 里，HOME 只负责把用户送过去。Android 11+ 不做
         包可见性声明就查不到它，「打开 Studio」会永远走「未安装」分支。 -->
    <queries>
        <package android:name="com.flue.studio" />
    </queries>

    <application
        android:name=".FlueApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WatchLauncher">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:icon="@mipmap/ic_settings_launcher"
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统设置在「应用信息页齿轮 / 默认应用当前选中项」等位置展示入口时
                 解析这个 action，点过去就是 Flue 的设置页。声明本身无副作用：
                 ROM 没实现就只是不显示入口；SettingsActivity 本就 exported=true
                 （LAUNCHER 入口），不存在新增暴露。 -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HeartRatePermissionRationaleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.WatchLauncher">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HeartRatePermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HeartRatePermissionRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ShortcutReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WatchLauncher">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ShortcutInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <!--
            clox External Data API（B5）：任何 App 都能往 10 个槽位里写一段字符串，
            表盘脚本通过 WF.thirdParty.slots[n] 读。

            必须 exported：上游定义的就是「无权限、任何已安装 App 都能写」，加权限门
            会让照 clox 写的集成方全部失效。所以槽位数据一律当不可信输入 ——
            长度上限、只当字符串、绝不进求值路径，见 WatchExternalData 的注释。

            两个动作：com.ailife.clox.WRITE_DATA 是为了兼容现有集成方，
            com.flue.launcher.WRITE_DATA 给新写的用。
        -->
        <!--
            接收器实现已随渲染层搬进 :watchface-runtime；FQCN 未变，
            所以这里仍按 app 包名（com.flue.launcher.*）寻址。
        -->
        <receiver
            android:name=".watchface.standard.WatchExternalDataReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ailife.clox.WRITE_DATA" />
                <action android:name="com.flue.launcher.WRITE_DATA" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".InternalWatchFaceConfigActivity"
            android:exported="false"
            android:label="@string/internal_watchface_config_title"
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".BuiltInFileManagerActivity"
            android:exported="false"
            android:label="@string/internal_watchface_config_title"
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait" />

        <!--
          WatchMaker 表盘画布调节页：本页渲染真实表盘，叠加参数面板即时预览。
          exported="false"：仅供 Flue 内部设置入口启动，不是网页宿主。
        -->
        <activity
            android:name=".CanvasAdjustActivity"
            android:exported="false"
            android:label="@string/settings_watchface_canvas_section"
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait" />

        <!--
          锁屏表盘：由 LauncherActivity 在 ACTION_SCREEN_OFF 时拉起，盖在 Keyguard 之上。
          singleInstance + taskAffinity="" 让它自成任务、不与 HOME 抢栈；excludeFromRecents
          保证它不会出现在最近任务里（一个锁屏皮肤出现在多任务里会很怪）。
        -->
        <activity
            android:name=".lockscreen.LockScreenWatchFaceActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WatchLauncher"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <!-- 锁屏表盘悬浮窗的保活前台服务：specialUse 类型需要 subtype 声明（API 34+ 校验），
             见 lockscreen/LockScreenFaceOverlayService 的类注释。 -->
        <service
            android:name=".lockscreen.LockScreenFaceOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the lock-screen watch-face overlay window alive while the device is locked" />
        </service>

        <service
            android:name=".service.WLauncherNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.FlueAccessibilityService"
            android:exported="true"
            android:label="@string/flue_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/flue_accessibility_service" />
        </service>

        <receiver
            android:name=".service.FlueDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/flue_device_admin" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
