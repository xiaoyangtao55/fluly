<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StudioApplication"
        android:allowBackup="false"
        android:label="Fluly Studio"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlulyStudio">


        <!-- Studio 只承载创作编辑器；商店由独立应用承载。
             label 与 theme 都用 Studio 自己的，避免依赖 launcher 的资源。 -->
        <activity
            android:name="com.fluly.launcher.WatchEditorActivity"
            android:exported="false"
            android:label="表盘编辑器"
            android:theme="@style/Theme.FlulyStudio.Editor"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StudioActivity"
            android:exported="true"
            android:label="Fluly Studio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
