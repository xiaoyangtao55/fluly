<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StudioApplication"
        android:allowBackup="false"
        android:label="Flue Studio"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlueStudio">


        <!-- 编辑器 / 商店：从 HOME 搬过来之后由 Studio 承载。
             label 与 theme 都用 Studio 自己的，避免依赖 launcher 的资源。 -->
        <activity
            android:name="com.flue.launcher.WatchEditorActivity"
            android:exported="false"
            android:label="表盘编辑器"
            android:theme="@style/Theme.FlueStudio.Editor"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.flue.launcher.WatchStoreActivity"
            android:exported="false"
            android:label="表盘商店"
            android:theme="@style/Theme.FlueStudio.Editor"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.flue.launcher.ui.store.WatchStoreWebActivity"
            android:exported="false"
            android:label="表盘商店"
            android:theme="@style/Theme.FlueStudio.Editor"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StudioActivity"
            android:exported="true"
            android:label="Flue Studio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
